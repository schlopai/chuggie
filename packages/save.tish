// save.tish — shared cartridge-SRAM helpers for chuggie-engine games.
//
// The engine (`cargo:tish_agb`) stores a fixed adventure blob per slot (scene, HP, score, flags,
// tile position). This package wraps those natives and adds NES-style file-select peek helpers.
// Games pack their own story bits into `flags` and pass a `formatDetail` callback for the UI.
//
//     import {
//       saveInit, saveAny, saveHas, saveErase, saveSlotCount,
//       saveWrite, saveLoad, saveGet, savePeek, saveFlagOn, firstEmptySlot,
//     } from '../../../packages/save'
//
//     saveInit()
//     if (saveAny() > 0) { /* show Continue */ }
//     saveWrite(slot, scene, maxHp, hp, gems, flags, pcol, prow, entryCol, entryRow)
//     if (saveLoad(slot) > 0) {
//       let g = saveGet()
//       // g.scene, g.maxHp, g.hp, g.score, g.flags, g.pcol, g.prow, g.entryCol, g.entryRow
//     }
//
// File-select peek (fills module state; read via savePeekEmpty / Label / Detail):
//     savePeek(slot, (scene, maxHp, hp, score, flags) => { return areaName(scene) + " …" })
import {
  save_init, save_has, save_any, save_write, save_read, save_erase, save_slots,
  save_scene, save_max_hp, save_hp, save_score, save_flags,
  save_pcol, save_prow, save_entry_col, save_entry_row,
} from 'cargo:tish_agb'

export let SAVE_FILE_COUNT: i32 = 3

// Last peek for file-select UIs (packages/menu). Not game state — shared module scratch.
const peek = {
  empty: 1,
  label: "",
  detail: "",
}

// Last load — object returned by saveGet() so callers avoid juggling many getters.
const loaded = {
  scene: 0,
  maxHp: 6,
  hp: 6,
  score: 0,
  flags: 0,
  pcol: 0,
  prow: 0,
  entryCol: 0,
  entryRow: 0,
}

function present(v) {
  if (v === null) { return 0 }
  if (typeof v === 'undefined') { return 0 }
  return 1
}

export function saveInit() {
  return save_init()
}

export function saveAny() {
  return save_any()
}

export function saveHas(slot) {
  return save_has(slot)
}

export function saveErase(slot) {
  return save_erase(slot)
}

export function saveSlotCount() {
  return save_slots()
}

// True if bit `mask` is set in `flags` (mask is a power of two: 1, 2, 4, …).
export function saveFlagOn(flags, mask) {
  let m = mask
  let v = flags
  while (m > 1) {
    v = (v - (v % 2)) / 2
    m = (m - (m % 2)) / 2
  }
  if ((v % 2) === 1) { return 1 }
  return 0
}

// Write one slot. `score` is currency / points / gems / rupees — whatever the game tracks.
export function saveWrite(slot, scene, maxHp, hp, score, flags, pcol, prow, entryCol, entryRow) {
  return save_write(slot, scene, maxHp, hp, score, flags, pcol, prow, entryCol, entryRow)
}

// Load `slot` into the shared `saveGet()` object. Returns 1 on success.
export function saveLoad(slot) {
  if (save_read(slot) === 0) { return 0 }
  loaded.scene = save_scene()
  loaded.maxHp = save_max_hp()
  loaded.hp = save_hp()
  loaded.score = save_score()
  loaded.flags = save_flags()
  loaded.pcol = save_pcol()
  loaded.prow = save_prow()
  loaded.entryCol = save_entry_col()
  loaded.entryRow = save_entry_row()
  return 1
}

// Snapshot from the last successful `saveLoad` (fields mirror the adventure blob).
export function saveGet() {
  return loaded
}

// First empty slot index, or -1 if all are full.
export function firstEmptySlot() {
  let n = SAVE_FILE_COUNT
  let i = 0
  while (i < n) {
    if (save_has(i) === 0) { return i }
    i = i + 1
  }
  return -1
}

export function savePeekEmpty() { return peek.empty }
export function savePeekLabel() { return peek.label }
export function savePeekDetail() { return peek.detail }

// Fill peek scratch for file-select. Optional `formatDetail(scene, maxHp, hp, score, flags)` → string.
// Default detail: "N HEARTS  M PTS".
export function savePeek(slot, formatDetail) {
  if (save_has(slot) === 0) {
    peek.empty = 1
    peek.label = "FILE " + (slot + 1) + "  -EMPTY-"
    peek.detail = ""
    return 0
  }
  save_read(slot)
  peek.empty = 0
  peek.label = "FILE " + (slot + 1)
  let scene = save_scene()
  let maxHp = save_max_hp()
  let hp = save_hp()
  let score = save_score()
  let flags = save_flags()
  if (present(formatDetail) > 0) {
    peek.detail = formatDetail(scene, maxHp, hp, score, flags)
  } else {
    let hearts = (maxHp + 1) / 2
    peek.detail = hearts + " HEARTS  " + score + " PTS"
  }
  return 1
}
