// AUTO-GENERATED by scripts/ffta_gen_clan_tables.py — do not edit.
// Source: data/ffta/tables/abilities.csv (the ROM) via seed_allowlist.json.
// Ability ids are the ROM's. They previously came from a 64-row wiki stub with its own
// numbering, so every runtime ability was mislabelled — id 1 read as First Aid when the
// ROM's ability 1 is Cure.
export let CLAN_ABILITIES = [
  { id: 1, name: "Cure", kind: "A", ap: 100, mp: 6 },
  { id: 2, name: "Cura", kind: "A", ap: 200, mp: 10 },
  { id: 23, name: "Fire", kind: "A", ap: 100, mp: 6 },
  { id: 67, name: "Item", kind: "A", ap: 100, mp: 0 },
  { id: 76, name: "First Aid", kind: "A", ap: 100, mp: 0 },
  { id: 112, name: "Rush", kind: "A", ap: 100, mp: 0 },
  { id: 168, name: "Steal: Gil", kind: "A", ap: 100, mp: 0 },
]

export function clanAbilityById(id) {
  let i = 0
  while (i < CLAN_ABILITIES.length) {
    if (CLAN_ABILITIES[i].id === id) { return CLAN_ABILITIES[i] }
    i = i + 1
  }
  return null
}

export function clanAbilityByName(name) {
  let i = 0
  while (i < CLAN_ABILITIES.length) {
    if (CLAN_ABILITIES[i].name === name) { return CLAN_ABILITIES[i] }
    i = i + 1
  }
  return null
}
