export function clanItemById(id) {
  let i = 0
  while (i < CLAN_ITEMS.length) {
    if (CLAN_ITEMS[i].id === id) { return CLAN_ITEMS[i] }
    i = i + 1
  }
  return null
}

export function clanItemByName(name) {
  let i = 0
  while (i < CLAN_ITEMS.length) {
    if (CLAN_ITEMS[i].name === name) { return CLAN_ITEMS[i] }
    i = i + 1
  }
  return null
}
