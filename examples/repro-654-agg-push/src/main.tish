// Repro #654 aggregate: push + length via shared cell (no boards_capt).
import { log, vblank, backdrop, hud_text, frame } from 'cargo:tish_agb'
import { body } from 'font:../../../assets/fonts/tinypixel.ttf@7'


// --- screen readout (scripts/add_screen_readout.py) ---
// Drawn up front so the ROM is never a blank screen; the measurement below is untouched.
backdrop(0x101018)
hud_text(0, 8, 8, "repro-654-agg-push")
hud_text(1, 8, 24, "running - numbers go to the log")
frame()
let boards = []

function pushBoard(b) {
  boards.push(b)
}

function countBoards() {
  return boards.length
}

pushBoard(1)
pushBoard(2)
pushBoard(3)
log("boards=" + countBoards())

let f: i32 = 0
while (f < 130) {
  if (f % 40 === 0) { pushBoard(f) }
  if (f % 40 === 1) { log("len=" + countBoards()) }
  vblank()
  f = f + 1
}
log("repro-654-agg-push done")
hud_text(1, 8, 24, "done - numbers are in the log")
while (true) { frame() }
