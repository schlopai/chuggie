// chart.tish — the cues the judge scores, GENERATED by scripts/gen_rap_dojo_music.py.
//
// Do not edit: this and the Lead track of assets/battle.deck are emitted from one table
// (PHRASES in that script) so the melody the master raps and the buttons the pupil must
// press cannot drift apart. Change the phrases there and re-run it.
import { chartPhrase } from '../../../packages/rhythm'

export let CHART_BPM: i32 = 96
export let CHART_PHRASES: i32 = 8

// Button codes, spelled out so the patterns below read as choreography.
let A: i32 = 0
let B: i32 = 1
let UP: i32 = 6
let DOWN: i32 = 7
let LEFT: i32 = 8
let RIGHT: i32 = 9

// ⚠️ Typed `i32[]`. An untyped tish array costs 28 bytes an element against 4 — small
// here, but these are the shape every chart in this genre has, and the habit is the point.
let OFF0: i32[] = [0, 4, 8, 12]
let BTN0: i32[] = [A, A, B, A]   // A, A, B, A
let OFF1: i32[] = [0, 4, 8, 12]
let BTN1: i32[] = [LEFT, RIGHT, LEFT, A]   // LEFT, RIGHT, LEFT, A
let OFF2: i32[] = [0, 4, 8, 12]
let BTN2: i32[] = [A, B, UP, A]   // A, B, UP, A
let OFF3: i32[] = [0, 4, 6, 8, 12]
let BTN3: i32[] = [LEFT, LEFT, RIGHT, A, B]   // LEFT, LEFT, RIGHT, A, B
let OFF4: i32[] = [0, 4, 8, 10, 12]
let BTN4: i32[] = [UP, DOWN, LEFT, RIGHT, A]   // UP, DOWN, LEFT, RIGHT, A
let OFF5: i32[] = [0, 2, 4, 8, 12]
let BTN5: i32[] = [A, A, B, LEFT, RIGHT]   // A, A, B, LEFT, RIGHT
let OFF6: i32[] = [0, 4, 6, 8, 12, 14]
let BTN6: i32[] = [A, UP, B, DOWN, LEFT, RIGHT]   // A, UP, B, DOWN, LEFT, RIGHT
let OFF7: i32[] = [0, 2, 4, 6, 8, 12]
let BTN7: i32[] = [A, B, A, B, LEFT, UP]   // A, B, A, B, LEFT, UP

/// Append every phrase of the lesson to the judge's chart. Called once, at load.
export function buildChart() {
  chartPhrase(CHART_BPM, 32, 16, OFF0, BTN0)
  chartPhrase(CHART_BPM, 64, 16, OFF1, BTN1)
  chartPhrase(CHART_BPM, 96, 16, OFF2, BTN2)
  chartPhrase(CHART_BPM, 128, 16, OFF3, BTN3)
  chartPhrase(CHART_BPM, 160, 16, OFF4, BTN4)
  chartPhrase(CHART_BPM, 192, 16, OFF5, BTN5)
  chartPhrase(CHART_BPM, 224, 16, OFF6, BTN6)
  chartPhrase(CHART_BPM, 256, 16, OFF7, BTN7)
}
