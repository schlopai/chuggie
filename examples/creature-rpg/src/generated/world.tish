// GENERATED by scripts/gen_creature_rpg.py — do not edit.
//
// The tall-grass mask for town.tmj, as 20 flat [row, firstCol, lastCol] runs covering
// 193 tiles. The map is the source: both this table and the tiles come from GRASS_PATCHES.
//
// This is a table and not a tile read because the engine gives no way to read a GID back out of a
// streamed map — and it wants to be cheap, because `tallGrass` is called on every completed step.

export let GRASS_RUNS: i32[] = [5, 5, 14, 6, 5, 14, 6, 24, 34, 7, 5, 14, 7, 24, 34, 8, 5, 14, 8, 24, 34, 9, 5, 14, 9, 24, 34, 12, 6, 14, 12, 25, 34, 13, 6, 14, 13, 25, 34, 14, 6, 14, 14, 25, 34, 15, 6, 17, 15, 25, 34, 16, 13, 17, 16, 25, 34, 17, 13, 17]

// 1 if (col, row) is tall grass, else 0. Linear over 20 runs, once per step — not per frame.
export function tallGrass(col: i32, row: i32): i32 {
  let i: i32 = 0
  while (i < GRASS_RUNS.length) {
    if (GRASS_RUNS[i] === row && col >= GRASS_RUNS[i + 1] && col <= GRASS_RUNS[i + 2]) { return 1 }
    i = i + 3
  }
  return 0
}
