{
  "name": "chiptune",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tish build src/main.tish --target gba -o \"$npm_package_name.gba\" && tish build src/tones.tish --target gba -o tones.gba",
    "verify": "./verify.sh",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "clean": "rm -rf .tish \"$npm_package_name.gba\" tones.gba"
  },
  "devDependencies": {
    "@tishlang/tish": "file:../../../../tish/tish/npm/tish"
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": {
        "path": "../../crates/tish-agb"
      },
      "tish_gba_scenepack": {
        "path": "../../crates/tish-gba-scenepack"
      }
    }
  },
  "description": "Demonstrates audio playback for chiptunes/music tracks."
}
