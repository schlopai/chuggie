track Hats id hats gen gameBoyDmg layer 2 * 16
  gen type noise noise_mode short vol 6 env_mode step env_step 2
  steps x . x x x . x . x . x x x . x .
  step_pitch 60

track Kick id kick gen gbaDirectSound layer 2 * 16
  gen waveform pulse duty 50 vol 14 bitcrush true pitch_drop -12 pitch_dec 0.06
  adsr a 0 d 0.1 s 0 r 0.03
  steps x . . . x . . . x . . . x . . .
  step_pitch 34

track Stab id stab gen gbaDirectSound layer 3 * 16
  gen waveform sawtooth vol 11 bitcrush true
  adsr a 0 d 0.08 s 0 r 0.05
  # A — one accent per chord
  note 50 0 0.2 v 100
  note 46 4 0.2 v 100
  note 53 8 0.2 v 106
  note 48 12 0.2 v 104
  # B — accents push against the bar line
  note 50 16 0.2 v 112
  note 50 18 0.15 v 96
  note 46 20 0.2 v 110
  note 53 24 0.2 v 116
  note 53 26 0.15 v 100
  note 48 28 0.2 v 114
  note 48 31 0.25 v 120
  # C — a hit on every beat through the peak
  note 50 32 0.15 v 127
  note 50 33 0.15 v 110
  note 53 34 0.15 v 120
  note 50 35 0.15 v 112
  note 46 36 0.2 v 127
  note 50 37 0.15 v 112
  note 53 38 0.15 v 120
  note 55 39 0.2 v 122
  note 53 40 0.15 v 127
  note 57 41 0.15 v 116
  note 53 42 0.15 v 120
  note 60 43 0.2 v 125
  note 48 44 0.15 v 127
  note 52 45 0.15 v 114
  note 55 46 0.15 v 120
  note 60 47 0.25 v 127
  # D — back to one per chord, last hit lands on the turnaround
  note 50 48 0.3 v 120
  note 46 52 0.3 v 114
  note 53 56 0.3 v 118
  note 48 60 0.3 v 116
  note 48 62 0.4 v 127
