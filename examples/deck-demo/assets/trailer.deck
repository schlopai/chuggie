# Trailer — high-intensity but harmonic 16-bar cue.
# Progression is a 4-bar i - VI - III - VII in D minor (Dm - Bb - F - C), stated four
# times: sparse, driving, peak (melody an octave up), then a resolve that lands on a
# suspended D so the loop point pulls back into the Dm.
#
# Intensifier stems (deckSetIntensity 0..3):
#   0 bed   — wave bass + pulse pad
#   1 heat  — pulse lead
#   2 drums — noise hats + PCM kick
#   3 peak  — PCM stabs
#
# Channel budget: 2 pulse (Pad, Lead) + 1 wave (Bass) + 1 noise (Hats) + 2 PCM
# (Kick, Stab) — exactly at the LR35902 / PCM caps.
deck 1
bpm 150

# Fundamental plus a decaying harmonic series — reads as a saw with the top rolled
# off, which keeps the bass thick without fighting the lead for space.
wave trailerbass harmonics 1 0.6 0.4 0.25 0.15

track Pad id pad gen gameBoyDmg layer 0 * 16
  gen type pulse duty 25 env_mode constant vol 5
  gen vib_rate 3 vib_amt 6
  # A — 5th of each chord, held
  note 57 0 4 v 70
  note 58 4 4 v 68
  note 57 8 4 v 72
  note 55 12 4 v 70
  # B — lifts to the 7th/3rd
  note 60 16 4 v 78
  note 58 20 4 v 74
  note 60 24 4 v 80
  note 64 28 4 v 82
  # C — top of the arc
  note 65 32 4 v 88
  note 62 36 4 v 84
  note 65 40 4 v 90
  note 67 44 4 v 92
  # D — settles back down
  note 69 48 4 v 86
  note 65 52 4 v 80
  note 65 56 4 v 78
  note 64 60 4 v 82

track Bass id bass gen gameBoyDmg layer 0 * 16
  gen type wave wave_shape trailerbass vol 15
  # Driving eighths on the root, octave on beat 2, fifth as the lead-in to the next bar.
