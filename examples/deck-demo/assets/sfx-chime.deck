# Short TPL sting — confirm / level-up sparkle (PCM + pulse).
deck 1
bpm 140

track Spark id spark gen gameBoyDmg
  gen type pulse duty 50 env_mode step vol 13
  note 72 0 0.12 v 120
  note 76 0.12 0.12 v 115
  note 79 0.24 0.2 v 127
  note 84 0.44 0.35 v 110

track Shimmer id shim gen gbaDirectSound
  gen waveform sine vol 10 bitcrush true
  adsr a 0 d 0.2 s 0 r 0.15
  note 96 0.2 0.4 v 90
