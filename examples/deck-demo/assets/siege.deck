# Siege — crossfading-stem-style intensifier (16 bars).
# L/R in tpl-demo raises intensity 0..3; stems share one playhead.
#   0 bed   — wave bass + soft pulse pad
#   1 heat  — pulse lead/arp
#   2 drums — noise hats + PCM kick
#   3 peak  — PCM stab hits
deck 1
bpm 132

track Pad id pad gen gameBoyDmg layer 0 * 16
  gen type pulse duty 25 env_mode constant vol 5
  gen vib_rate 3 vib_amt 8
  # A — open air
  note 55 0 4 v 70
  note 58 4 4 v 65
  note 60 8 4 v 75
  note 58 12 4 v 70
  # B — darker
  note 53 16 4 v 70
  note 55 20 4 v 65
  note 58 24 4 v 80
  note 55 28 4 v 70
  # C — climb
  note 55 32 2 v 75
  note 58 34 2 v 80
  note 60 36 2 v 85
  note 63 38 2 v 90
  note 60 40 4 v 85
  note 58 44 4 v 80
  # D — hold / resolve
  note 55 48 4 v 85
  note 53 52 4 v 75
  note 55 56 4 v 80
  note 58 60 4 v 85

