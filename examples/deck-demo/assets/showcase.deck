  note 65 68 4 v 74
  note 62 72 4 v 72
  note 69 76 4 v 76

track Pluck id pluck gen gameBoyDmg layer 1 * 20
  gen type wave wave_shape nylon vol 11 env_mode adsr
  adsr a 0.004 d 0.55 s 4 r 0.30
  # S1 is bare on purpose — the theme has not arrived yet.
  # S2 — the theme, stated plainly
  note 69 16 0.5 v 100
  note 72 16.5 0.5 v 96
  note 76 17 1 v 108
  note 72 18 0.5 v 98
  note 69 18.5 1.5 v 104
