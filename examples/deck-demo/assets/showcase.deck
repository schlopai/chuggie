track Arp id arp gen gameBoyDmg layer 1 * 20
  gen type pulse duty 25 env_mode constant vol 6
  # Hardware arpeggio: one held note, the channel alternates it with the fifth
  # faster than the sequencer could retrigger. Costs one channel, not three.
  gen arp_rate 10 arp_semis 7
  note 57 16 4 v 70
  note 53 20 4 v 70
  note 48 24 4 v 70
  note 55 28 4 v 72
  note 69 32 4 v 80
  note 65 36 4 v 80
  note 60 40 4 v 80
  note 67 44 4 v 84
  note 72 48 4 v 92
  note 69 52 4 v 92
  note 64 56 4 v 92
  note 68 60 4 v 96
  note 69 64 4 v 72
  note 65 68 4 v 70
  note 62 72 4 v 70
  note 69 76 4 v 74

track Hats id hats gen gameBoyDmg layer 2 * 20
  gen type noise noise_mode short vol 6 env_mode step env_step 2
  steps x . x x x . x . x . x x x . x .
  step_pitch 60

track Kick id kick gen gbaDirectSound layer 2 * 20
  gen waveform pulse duty 50 vol 14 bitcrush true pitch_drop -12 pitch_dec 0.06
  adsr a 0 d 0.1 s 0 r 0.03
  steps x . . . x . . x x . . . x . . .
  step_pitch 34

track Stab id stab gen gbaDirectSound layer 3 * 20
  gen waveform sawtooth vol 10 bitcrush true
  adsr a 0 d 0.08 s 0 r 0.05
  note 57 32 0.2 v 110
  note 53 36 0.2 v 110
  note 48 40 0.2 v 112
