  note 41 54.5 0.5 v 98
  note 53 55 0.5 v 118
  note 48 55.5 0.5 v 108
  note 36 56 0.5 v 127
  note 36 56.5 0.5 v 98
  note 48 57 0.5 v 118
  note 36 57.5 0.5 v 98
  note 36 58 0.5 v 122
  note 36 58.5 0.5 v 98
  note 48 59 0.5 v 118
  note 43 59.5 0.5 v 108
  # bar 15 — E major, the lift
  note 40 60 0.5 v 127
  note 40 60.5 0.5 v 100
  note 52 61 0.5 v 120
  note 40 61.5 0.5 v 100
  note 40 62 0.5 v 124
  note 44 62.5 0.5 v 110
