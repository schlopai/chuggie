  note 84 53.5 0.5 v 116
  note 81 54 2 v 124
  note 88 56 0.5 v 127
  note 91 56.5 0.5 v 122
  note 88 57 1 v 127
  note 84 58 2 v 124
  # bar 15 — G# from the harmonic minor over the E
  note 83 60 1 v 127
  note 88 61 1 v 124
  note 92 62 0.5 v 127
  note 88 62.5 1.5 v 127
