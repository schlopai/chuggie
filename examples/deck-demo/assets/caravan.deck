  note 80 21.5 0.06 v 50
  note 80 23 0.08 v 75
  note 80 25 0.08 v 80
  note 80 27 0.08 v 70
  note 80 29 0.08 v 80
  note 80 31 0.08 v 70
  # bridge quieter
  note 80 35 0.08 v 45
  note 80 39 0.08 v 40
  note 80 43 0.08 v 50
  note 80 47 0.08 v 45
  note 80 49 0.08 v 70
  note 80 51 0.08 v 60
  note 80 53 0.08 v 75
  note 80 55 0.08 v 65
  note 80 57 0.08 v 80
  note 80 57.5 0.06 v 55
  note 80 59 0.08 v 75
  note 80 61 0.08 v 80
  note 80 63 0.08 v 70

track Kick id kick gen gbaDirectSound * 16
  gen waveform pulse duty 50 vol 12 bitcrush true pitch_drop -10 pitch_dec 0.07
  adsr a 0 d 0.11 s 0 r 0.04
  note 36 0 0.14 v 110
  note 36 4 0.14 v 100
  note 36 8 0.14 v 115
  note 36 12 0.14 v 105
  note 36 16 0.14 v 120
  note 36 18 0.12 v 90
  note 36 20 0.14 v 120
  note 36 24 0.14 v 115
  note 36 28 0.14 v 120
  note 36 32 0.16 v 85
