{
  "name": "ringside",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "python3 ../../scripts/stamp_build.py . && tish build src/main.tish --target gba -o \"$npm_package_name.gba\"",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "shot": "npm run build && ../../scripts/screenshot.sh \"$npm_package_name.gba\" screenshot.png 900 \"100:start,220:a,300:l,380:b\"",
    "gif": "npm run build && ../../scripts/gif.sh \"$npm_package_name.gba\" screenshot.gif 900 \"100:start,220:a,300:l,380:b\"",
    "assets": "python3 ../../scripts/gen_ringside.py",
    "clean": "rm -rf .tish .buildno src/buildid.tish \"$npm_package_name.gba\" \"$npm_package_name.sav\"",
    "verify": "./verify.sh"
  },
  "devDependencies": {
    "@tishlang/tish": "file:../../../../tish/tish/npm/tish"
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": {
        "path": "../../crates/tish-agb"
      },
      "tish_gba_scenepack": {
        "path": "../../crates/tish-gba-scenepack"
      }
    }
  },
  "description": "A Punch-Out-style boxing game seen over the player's shoulder: an opponent that is a data table of tells, and a fight that is pure reaction timing."
}
