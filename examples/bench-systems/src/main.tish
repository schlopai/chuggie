// Where the native pass goes, system by system.
//
// `bench-room` proved native enemies are nearly free and `gba-engine-cost-per-live-entity`
// measured ~60 ticks per live entity across the WHOLE pass — but never said WHICH of the ~32
// systems carry it, or what a slot costs a system the game never asked for. This bench does:
// it spawns N callback-free entities (transform + collider + body, NO behaviours, NO sprites),
// doubles N every 256 frames, and prints each system's own ticks from `sys_ticks`.
//
// Read it as: every non-zero line for a system this ROM does not use is pure scan tax — the
// thing S1 (zero-user early-outs) exists to delete; the growth per doubling is the per-slot
// scan cost S2 (live-slot list) exists to delete.
//
// ⚠️ Short log lines on purpose — a long concat chain is a heap OOM on the frame it prints.
import { log, backdrop, hud_text, frame } from 'cargo:tish_agb'
import { body } from 'font:../../../assets/fonts/tinypixel.ttf@7'
import { spawn, set_transform, set_collider, set_body, world_step,
         step_ticks, frame_period, entity_count,
         sys_prof, sys_ticks, sys_count, sys_name } from 'cargo:tish_gba_game_engine'


// --- screen readout (scripts/add_screen_readout.py) ---
// Drawn up front so the ROM is never a blank screen; the measurement below is untouched.
backdrop(0x101018)
hud_text(0, 8, 8, "bench-systems")
hud_text(1, 8, 24, "running - numbers go to the log")
frame()
sys_prof(1)

let n: i32 = 0

// Grow the world to `target` entities: plain movers that bounce nowhere near anything.
function grow(target: i32) {
  while (n < target) {
    let e: i32 = spawn()
    set_transform(e, ((n * 37) & 191) + 8.0, ((n * 53) & 127) + 8.0)
    set_collider(e, 8.0, 8.0)
    set_body(e, 0.25, 0.25)
    n = n + 1
  }
}

function report() {
  log("N=" + n + " ents=" + entity_count() + " s0=" + step_ticks(0)
      + " s2=" + step_ticks(2) + " FP=" + frame_period(2))
  let i: i32 = 0
  let m: i32 = sys_count()
  while (i < m) {
    let t: i32 = sys_ticks(i)
    if (t > 0) { log("  sys " + sys_name(i) + "=" + t) }
    i = i + 1
  }
}

grow(8)
let f: i32 = 0
while (f < 1300) {
  world_step()
  f = f + 1
  // Mid-window, so the numbers are steady-state and not the growth frame's.
  if ((f & 255) === 128) { report() }
  if ((f & 255) === 0) {
    if (n < 64) { grow(n * 2) }
  }
}
log("bench-systems done")
hud_text(1, 8, 24, "done - numbers are in the log")
while (true) { frame() }
