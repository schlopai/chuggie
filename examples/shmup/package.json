{
  "name": "shmup",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tish build src/main.tish --target gba -o \"$npm_package_name.gba\"",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "shot": "npm run build && ../../scripts/screenshot.sh \"$npm_package_name.gba\" screenshot.png",
    "gif": "npm run build && ../../scripts/gif.sh \"$npm_package_name.gba\" screenshot.gif",
    "clean": "rm -rf .tish \"$npm_package_name.gba\" \"$npm_package_name.sav\""
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": {
        "path": "../../crates/tish-agb"
      },
      "tish_gba_game_engine": {
        "path": "../../crates/tish-gba-game-engine"
      }
    }
  },
  "description": "A shoot-em-up (shmup) genre template with bullet patterns and enemies."
}
