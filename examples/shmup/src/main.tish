// shmup — a top-down scrolling shoot-'em-up, built on the reusable packages/shmup toolkit.
//
// Fly with the d-pad; the ship AUTO-FIRES upward (so there's always action on screen). Shoot the
// descending grunts, dodge the weavers and the shooters' aimed fire, grab the gold weapon-up orbs to
// widen your shot, then survive the battlecruiser boss's three attack phases. Score, lives, weapon
// level and the boss's health all show in the HUD. Press SELECT to toggle a performance overlay.
//
// Everything genre-specific — projectiles, contact damage, off-screen cleanup, patterned enemy AI,
// the scripted wave timeline, the phased boss — comes from packages/shmup (and, under it, the native
// engine's projectile-combat + lifetime + free-velocity + movement primitives). This file is just the
// LEVEL: which sheets to use, and what spawns when.
//
// Density comes from BULLETS, straight grunts, and NATIVE-movement weavers — none of which cost a
// per-frame tish callback. Only the shooters (fire cadence) and the boss (phase logic) run a tick.
import { ships } from 'sheet:../assets/ships16.png'
import { bossSheet } from 'sheet32:../assets/boss32.png'
import { starsNear } from 'background:../assets/stars_near.png'
import {
  shmupInit, loadStars, scrollStars, step, gameState,
  spawnPlayer, spawnGrunt, spawnWeaver, spawnShooter, spawnBoss, spawnRow, makeDirector
} from '../../../packages/shmup'
import { hud_text, hud_bar, backdrop, key_pressed } from 'cargo:tish_agb'
import { entity_count, entity_slots, step_ticks, step_peak, frame_period, step_peak_reset } from 'cargo:tish_gba_game_engine'

backdrop(0x05060f)                                   // deep-space blue behind the stars
shmupInit({ sheet: ships, bossSheet: bossSheet })    // wire up the sheets (default frame layout)
loadStars(starsNear, 1)                              // one scrolling star layer
spawnPlayer(120, 135, {})

// The scripted level: waves of enemies over time, a couple of weapon-drop chances, then the boss.
// Authored as data — `{ at: frame, run: () => {…} }`, ascending. This is the whole "level design".
let level = makeDirector([
  { at: 30,  run: () => { spawnRow(4, 34, (x) => { spawnGrunt(x, {}) }) } },
  { at: 95,  run: () => { spawnRow(5, 28, (x) => { spawnGrunt(x, { drop: x > 150 ? 1 : 0 }) }) } },
  { at: 165, run: () => { spawnWeaver(80, {}); spawnWeaver(165, {}) } },
  { at: 240, run: () => { spawnRow(5, 28, (x) => { spawnGrunt(x, {}) }) } },
  { at: 300, run: () => { spawnShooter(120, {}) } },
  { at: 360, run: () => { spawnRow(4, 30, (x) => { spawnGrunt(x, { drop: x > 150 ? 1 : 0 }) }) } },
  { at: 430, run: () => { spawnWeaver(60, {}); spawnWeaver(180, {}) } },
  { at: 520, run: () => { spawnBoss({ hp: 55 }) } }
])

// SELECT (button 2) toggles a live performance overlay. It re-lays-out its text only every 8
// frames so the overlay itself barely costs anything. Typed struct, not a bare object — the
// flag is read inside drawHud() every frame, and a typed field is a native load where an
// object property is an uncached key scan.
interface Dbg { on: i32 }
let dbg: Dbg = { on: 0 }

// The overlay: game-time, live vs high-water entity counts, and the world_step tick budget broken
// down (tot / behaviours+ticks / collisions). ~4389 ticks = one 60fps frame. Throttled to 8-frame
// steps so its own text relayout doesn't skew what it's measuring.
function drawPerf() {
  // One short line: EMA full-frame period (the sustained cost — ~4389 = 60fps, ~8778 = 30fps) + world
  // step total + entity count. Kept SHORT and low-churn so the overlay itself barely taxes the frame
  // it's measuring (the 2-line version re-rendered ~80 glyphs/tick and skewed the reading).
  hud_text(7, 4, 122, "cb" + step_ticks(1) + " nat" + step_ticks(2) + " col" + step_ticks(3) + " rnd" + step_ticks(4))
  hud_text(8, 4, 132, "tot" + step_ticks(0) + " frm~" + frame_period(2) + " e" + entity_count())
}

// Only re-issue a HUD line when its value actually changed. Building the string ("SCORE " + n) and
// re-rendering the glyphs every frame — for values that change a few times a second — was a big slice
// of the frame budget (the boss's health bar alone rebuilt 27 chars every frame), enough to tip a
// busy frame past the 4389-tick 60fps budget into 30fps. hud_text already caches its render, but the
// tish-side string build ran regardless; this gate skips both.
interface HudLast { score: i32, weapon: i32, lives: i32, bossHp: i32, end: i32, dbgCleared: i32 }
let hudLast: HudLast = { score: -1, weapon: -1, lives: -1, bossHp: -2, end: 0, dbgCleared: 1 }
function drawHud() {
  let gs: GameState = gameState()
  if (gs.score !== hudLast.score) { hud_text(0, 6, 4, "SCORE " + gs.score); hudLast.score = gs.score }
  if (gs.weapon !== hudLast.weapon) { hud_text(1, 150, 4, "PWR " + gs.weapon); hudLast.weapon = gs.weapon }
  if (gs.lives !== hudLast.lives) { hud_text(2, 205, 4, "x" + gs.lives); hudLast.lives = gs.lives }
  // Boss health as a graphical bar — gated on an actual HP change (like the lines above). The boss is
  // alive for the busiest part of the game, so issuing hud_bar + "BOSS" every frame (each a boxed call
  // plus the bossHp/bossMax reads and the ratio divide) was pure per-frame tax that vanished the instant
  // the boss died. Now it only redraws when bossHp moves — a few times a second.
  if (gs.bossMax > 0 && !gs.bossDead) {
    if (gs.bossHp !== hudLast.bossHp) {
      hud_bar(0, 8, 148, 64, 7, gs.bossHp / gs.bossMax, 0xF04038, 0x3a1410)
      hud_text(3, 76, 149, "BOSS")
      hudLast.bossHp = gs.bossHp
    }
  } else if (hudLast.bossHp !== -1) {
    hud_bar(0, 0, 0, 0, 0, 0, 0, 0)   // w<=0 clears the bar
    hud_text(3, 0, 0, "")
    hudLast.bossHp = -1
  }
  if (dbg.on === 1) {
    if (level.time() % 16 === 0) { drawPerf() }
    hudLast.dbgCleared = 0
  } else if (hudLast.dbgCleared === 0) {
    // Clear ONCE on toggle-off — issuing two empty hud_text calls every frame was its own tax.
    hud_text(7, 0, 0, "")
    hud_text(8, 0, 0, "")
    hudLast.dbgCleared = 1
  }
}

while (true) {
  scrollStars(level.time())
  if (key_pressed(2) > 0) { dbg.on = 1 - dbg.on }   // SELECT toggles the perf overlay
  level.update()
  drawHud()
  let gs: GameState = gameState()
  // Draw the end screen ONCE — rebuilding "SCORE " + n every game-over frame is the exact
  // thing the HudLast gate above exists to prevent, and this branch was doing it anyway.
  if (hudLast.end === 0) {
    if (gs.bossDead) {
      hud_text(4, 96, 74, "YOU WIN!")
      hud_text(5, 78, 90, "SCORE " + gs.score)
      hudLast.end = 1
    } else if (gs.playerDead) {
      hud_text(4, 90, 74, "GAME OVER")
      hud_text(5, 78, 90, "SCORE " + gs.score)
      hudLast.end = 1
    }
  }
  step()
}
