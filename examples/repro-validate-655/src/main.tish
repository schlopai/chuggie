import { log, vblank, backdrop, hud_text, frame } from 'cargo:tish_agb'
import { body } from 'font:../../../assets/fonts/tinypixel.ttf@7'


// --- screen readout (scripts/add_screen_readout.py) ---
// Drawn up front so the ROM is never a blank screen; the measurement below is untouched.
backdrop(0x101018)
hud_text(0, 8, 8, "repro-validate-655")
hud_text(1, 8, 24, "running - numbers go to the log")
frame()
function rec(n) {
  if (n <= 0) { return 0 }
  return 1 + rec(n - 1)
}

log("start")
let got = "none"
try {
  let r = rec(2000)
  got = "returned " + r
} catch (e) {
  got = "caught " + e
}
log("shallow: " + got)

// ⚠️ THE POINT OF #655. Before the fix the floor fell back to 1, so no SP could ever be below it and
// this depth simply ran off the end of IWRAM — a jump through a wild pointer with no message. With a
// real floor it must come back as a CATCHABLE error instead.
let deep = "none"
try {
  let d = rec(200000)
  deep = "returned " + d
} catch (e) {
  deep = "caught"
}
log("deep: " + deep)
let f: i32 = 0
while (f < 60) { vblank() f = f + 1 }
log("done")
hud_text(1, 8, 24, "done - numbers are in the log")
while (true) { frame() }
