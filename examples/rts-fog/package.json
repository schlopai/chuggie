{
  "name": "rts-fog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "assets": "python3 ../../scripts/gen_rts_spikes.py",
    "build": "tish build src/main.tish --target gba -o \"$npm_package_name.gba\"",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "shot": "npm run build && ../../scripts/screenshot.sh \"$npm_package_name.gba\" screenshot.png 300",
    "gif": "npm run build && ../../scripts/gif.sh \"$npm_package_name.gba\" screenshot.gif 300",
    "verify": "bash verify.sh",
    "clean": "rm -rf .tish \"$npm_package_name.gba\" \"$npm_package_name.sav\" screenshot.png"
  },
  "devDependencies": {
    "@tishlang/tish": "3.10.3"
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": { "path": "../../crates/tish-agb" },
      "tish_gba_game_engine": { "path": "../../crates/tish-gba-game-engine" },
      "tish_gba_scenepack": { "path": "../../crates/tish-gba-scenepack" }
    }
  },
  "description": "RTS de-risk A2: fog of war as a wrapping shroud layer over a scrolling scene map, and whether the BG budget holds."
}
