{
  "name": "cosmo-kitchen",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "gen:music": "python3 scripts/gen_music.py",
    "build": "tish build src/main.tish --target gba -o \"$npm_package_name.gba\"",
    "verify": "./verify.sh",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "clean": "rm -rf .tish \"$npm_package_name.gba\""
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": {
        "path": "../../crates/tish-agb"
      },
      "tish_gba_scenepack": {
        "path": "../../crates/tish-gba-scenepack"
      }
    }
  },
  "description": "A complete mini-game demo (Cosmo Kitchen) showing game loop and UI."
}
