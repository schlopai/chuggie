// Cosmo Kitchen audio router — what games call.
import { deckPlay, deckStop, deckSetIntensity, deckIntensity } from '../../../packages/deck'
import {
  chipCoin, chipAccept, chipBlip, chipSlash, chipWhoosh,
  chipHit, chipCancel, chipChime,
} from '../../../packages/chipsfx'
import {
  sfxSizzle, sfxChop, sfxLadle, sfxMicrowave, sfxOrderBell,
  sfxCardFlip, sfxPop, sfxFizz, sfxWhistle, sfxFridge,
  sfxSteam, sfxClink, sfxSpatula, sfxTimer, sfxGreaseFire, sfxBubbling, sfxSpoon,
} from './sfx'

import { titleNeonDiner } from 'deck:../assets/music/title-neon-diner.deck'
import { hubStarportMarket } from 'deck:../assets/music/hub-starport-market.deck'
import { menuClipboard } from 'deck:../assets/music/menu-clipboard.deck'
import { shopVendomat } from 'deck:../assets/music/shop-vendomat.deck'
import { zoneHyperspaceCruise } from 'deck:../assets/music/zone-hyperspace-cruise.deck'
import { zoneAgriDome } from 'deck:../assets/music/zone-agri-dome.deck'
import { zoneNeonNightMarket } from 'deck:../assets/music/zone-neon-night-market.deck'
import { zoneCruiseLiner } from 'deck:../assets/music/zone-cruise-liner.deck'
import { zoneAsteroidDiner } from 'deck:../assets/music/zone-asteroid-diner.deck'
