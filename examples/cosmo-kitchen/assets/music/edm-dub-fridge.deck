# Dub Fridge - dub techno
# Sparse Dub techno. Fake delay taps. Half-time kick.
deck 1
bpm 118

track Pad id pad gen gameBoyDmg * 16
  gen type pulse duty 12_5 env_mode constant vol 4
  gen vib_rate 1 vib_amt 16
  note 62 0 3.8 v 50
  note 62 4 3.8 v 50
  note 62 8 3.8 v 50
  note 62 12 3.8 v 50
  note 60 16 3.8 v 50
