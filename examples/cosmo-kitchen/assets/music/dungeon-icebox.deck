# Icebox - freezer dungeon
# Sparse Dorian. Drips. Almost hollow.
deck 1
bpm 78

track Pad id pad gen gameBoyDmg * 16
  gen type pulse duty 12_5 env_mode constant vol 3
  gen vib_rate 1 vib_amt 6
  note 57 0 3.95 v 60
  note 55 4 3.95 v 65
  note 65 8 3.95 v 70
  note 64 12 3.95 v 75
  note 57 16 3.95 v 80
  note 55 20 3.95 v 60
  note 65 24 3.95 v 65
  note 64 28 3.95 v 70
  note 57 32 3.95 v 75
  note 60 36 3.95 v 80
  note 55 40 3.95 v 60
  note 64 44 3.95 v 65
  note 57 48 3.95 v 70
  note 65 52 3.95 v 75
  note 64 56 3.95 v 80
  note 57 60 3.95 v 60

track Lead id lead gen gameBoyDmg * 16
  gen type pulse duty 25 env_mode constant vol 9
  gen vib_rate 1 vib_amt 8
  note 62 1.5 1.5 v 80
  note 57 8.5 0.5 v 70
  note 60 10.5 1.2 v 85
  note 62 17.5 1.5 v 80
  note 57 24.5 0.5 v 70
