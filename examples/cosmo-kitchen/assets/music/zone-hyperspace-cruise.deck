# Hyperspace Cruise - overworld
# Pedal drone + planing thirds. Slow glide.
deck 1
bpm 100

track Pad id pad gen gameBoyDmg * 16
  gen type pulse duty 25 env_mode constant vol 6
  gen vib_rate 2 vib_amt 18
  note 53 0 3.95 v 60
