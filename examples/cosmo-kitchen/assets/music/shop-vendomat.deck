# Vendomat - shop
# Staccato vendor jingle in G. Order-bell friendly tops.
deck 1
bpm 128

track Pad id pad gen gameBoyDmg * 12
  gen type pulse duty 50 env_mode constant vol 4
  gen vib_rate 6 vib_amt 4
  note 55 0 3.95 v 60
  note 52 4 3.95 v 65
  note 48 8 3.95 v 70
  note 50 12 3.95 v 75
  note 55 16 3.95 v 80
  note 57 20 3.95 v 60
  note 50 24 3.95 v 65
  note 55 28 3.95 v 70
  note 55 32 3.95 v 75
  note 52 36 3.95 v 80
  note 50 40 3.95 v 60
  note 55 44 3.95 v 65

