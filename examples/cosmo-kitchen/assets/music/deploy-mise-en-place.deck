# Mise en Place - deploy
# Sus ticks + occasional spoon. Prep tension.
deck 1
bpm 108

track Pad id pad gen gameBoyDmg * 12
  gen type pulse duty 25 env_mode constant vol 4
  gen vib_rate 2 vib_amt 8
  note 55 0 3.95 v 60
