// Ship classes, and a MODULAR weapon system — literal tables only, no functions.
//
// ⚠️ EVERY ARRAY IS A POWER OF TWO LONG, AND LONGER THAN IT NEEDS TO BE. A masked index is only free
// if the mask is provably inside the array: `SHIP_HP[cls & 3]` over a THREE element array cannot be
// proven in bounds, so the compiler emits an f64 bounds-check fallback — 25 ticks against 0.45, and
// its f64 type then poisons every expression it feeds. Measured in examples/artillery's generated
// Rust. Weapons are indexed `(cls << 2) | slot`, a shift-or, never `cls * 4 + slot`.

// ── Classes ──────────────────────────────────────────────────────────────────────────────────────
//        LANCE  TORTOISE  HORNET   (pad)
export let SHIP_HP: i32[] = [90, 140, 105, 0]
export let SHIP_FUEL: i32[] = [90, 60, 140, 0]
export let SHIP_THR: i32[] = [26, 16, 38, 0]      // Q8 px per tick^2 of thrust
export let SHIP_SPD: i32[] = [288, 208, 256, 0]   // Q8 multiplier on muzzle speed
// Incoming blast damage is scaled by (256 - DEF) >> 8, so a TORTOISE eats 37% less than the number
// on the weapon says. Without it, HP was the only thing separating the hulls in a fight.
export let SHIP_DEF: i32[] = [24, 96, 56, 0]      // 9% / 37% / 22%

// ════════════════════════════════════════════════════════════════════════════════════════════════
// A WEAPON IS A SHOT PLUS A WARHEAD, AND THE TWO ARE INDEPENDENT.
//
// The SHOT is delivery: how many leave the tube, whether they open mid-flight, whether they bore
// through rock. The WARHEAD is arrival: what each piece does where it lands. Nothing about a shot
// implies its warhead, which is the whole point — a fan of builders lays three walls at once, a
// splitter of diggers opens into a shaft cluster, and the same BLAST warhead is a plain shell on one
// rack and cluster munitions on another.
//
// Composing them means a new weapon is one row of three numbers rather than a new branch in the
// flight loop, and a new BEHAVIOUR is one branch that every existing weapon can then be built from.
// It also means a split piece can differ from the shell that carried it: each piece inherits the
// warhead, not the shot, so opening a SPLIT does not re-run the delivery.
// ════════════════════════════════════════════════════════════════════════════════════════════════

// ── Shot kinds (delivery) ───────────────────────────────────────────────────────────────────────
export let SK_SINGLE: i32 = 0     // one projectile
export let SK_FAN: i32 = 1        // several at the muzzle, spread across an arc
export let SK_SPLIT: i32 = 2      // one that opens into several after a fuse
export let SK_BORE: i32 = 3       // chews through terrain instead of stopping at it

// ── Warhead kinds (arrival) ─────────────────────────────────────────────────────────────────────
export let WK_BLAST: i32 = 0      // ordinary crater and damage
export let WK_HEAVY: i32 = 1      // more of both
export let WK_FRAG: i32 = 2       // little damage, little hole — dangerous in numbers
export let WK_DIGGER: i32 = 3     // small blast, big hole: for opening a way through
export let WK_BUILDER: i32 = 4    // ADDS terrain instead of removing it

// ── The shot library, 8 slots ───────────────────────────────────────────────────────────────────
//   0 SINGLE   1 FAN3    2 FAN5    3 SPLIT3   4 SPLIT5   5 BORE    6 LOB
export let SH_KIND: i32[] = [0, 1, 1, 2, 2, 3, 0, 0]
export let SH_COUNT: i32[] = [1, 3, 5, 3, 5, 1, 1, 1]
export let SH_FUSE: i32[] = [0, 0, 0, 40, 45, 0, 0, 0]      // SPLIT only
export let SH_ARC: i32[] = [0, 5, 8, 6, 5, 0, 0, 0]         // fan half-width, 1/256ths of a turn
export let SH_PEN: i32[] = [0, 0, 0, 0, 0, 26, 0, 0]        // BORE only: substeps of rock it can chew
export let SH_SPD: i32[] = [256, 248, 244, 230, 240, 300, 200, 256]   // Q8 muzzle multiplier

// ── The warhead library, 8 slots ────────────────────────────────────────────────────────────────
//   0 BLAST   1 HEAVY   2 FRAG   3 DIGGER   4 BUILDER
export let WH_KIND: i32[] = [0, 1, 2, 3, 4, 0, 0, 0]
export let WH_DMG: i32[] = [34, 60, 15, 20, 4, 0, 0, 0]
export let WH_R: i32[] = [24, 34, 15, 12, 10, 0, 0, 0]      // blast radius, px
export let WH_RINV: i32[] = [2730, 1927, 4369, 5461, 6553, 0, 0, 0]   // 65536 / WH_R, no runtime divide
// Terrain effect radius. For BUILDER this is how much ground it LAYS; for everything else how much
// it takes away. A DIGGER's hole is far bigger than its blast, which is what makes it a tool.
export let WH_TERR: i32[] = [22, 34, 12, 30, 26, 0, 0, 0]

// ── The racks: (cls << 2) | slot -> a shot, a warhead, an ammo count ────────────────────────────
// LANCE     BOLT        FAN         BORE          SPIKE
// TORTOISE  SHELL       SIEGE       SPLITTER      RAMPART
// HORNET    STING       SWARM       SCATTER       TERRA
export let W_SHOT: i32[] = [
  0, 1, 5, 0,
  0, 6, 3, 0,
  0, 4, 2, 1,
  0, 0, 0, 0
]
export let W_WARHEAD: i32[] = [
  0, 2, 3, 1,
  0, 1, 0, 4,
  0, 2, 2, 4,
  0, 0, 0, 0
]
export let W_AMMO: i32[] = [        // -1 = unlimited
  0 - 1, 6, 4, 2,
  0 - 1, 1, 6, 3,
  0 - 1, 3, 4, 4,
  0, 0, 0, 0
]
