{
  "name": "pong-link",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tish build src/main.tish --target gba -o \"$npm_package_name.gba\"",
    "verify": "./verify.sh",
    "start": "npm run build && (mgba-qt \"$npm_package_name.gba\" || mgba \"$npm_package_name.gba\")",
    "link": "npm run build && ../../scripts/link.sh \"$npm_package_name.gba\"",
    "shot": "npm run build && ../../scripts/screenshot.sh \"$npm_package_name.gba\" screenshot.png 300",
    "gif": "npm run build && ../../scripts/gif.sh \"$npm_package_name.gba\" screenshot.gif 300",
    "assets": "python3 ../../scripts/gen_pong_link.py",
    "clean": "rm -rf .tish \"$npm_package_name.gba\" \"$npm_package_name.sav\" screenshot.png"
  },
  "tish": {
    "rustDependencies": {
      "tish_agb": {
        "path": "../../crates/tish-agb"
      },
      "tish_gba_scenepack": {
        "path": "../../crates/tish-gba-scenepack"
      }
    }
  },
  "description": "Two-player Pong over the link cable: lockstep, where the only thing crossing the wire is a button mask."
}
