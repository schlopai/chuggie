// The roster's frame data.
//
// Every character shares one move list and one set of animation slots — the sheets are built to a
// fixed 24-pose layout (scripts/gen_versus.py), so what makes a character is NUMBERS: how fast it
// walks, how long its heavy punch takes to come out, how far the sweep reaches, what motion the
// special wants. That is the whole point of putting frame data in a table: a new fighter is a call
// to `define`, not a new file.
//
// ── Reading the timings ──────────────────────────────────────────────────────────────────────────
// startup / active / recovery are frames at 60fps. A move is safe on block when the defender's
// blockstun outlasts the attacker's recovery, and punishable when it does not — so the light punch
// (3/3/6, 7 blockstun) leaves the attacker free two frames before the defender, and the heavy
// (7/4/14, 10 blockstun) leaves them at -4 and eating whatever the defender presses. Those two
// numbers are the entire risk/reward of poking, and they are two columns of a table.
import {
  MV_LP, MV_HP, MV_LK, MV_HK, MV_CR_LP, MV_CR_HK, MV_SP1, MV_SP2, MV_THROW,
  KIND_MID, KIND_LOW, KIND_OVERHEAD, KIND_UNBLOCKABLE,
  fighterDefChar, fighterDefMove, fighterDefBox, fighterDefInput, fighterDefCancel,
  fighterDefFxCell,
} from '../../../packages/fighter'
import { BTN_LP, BTN_HP, BTN_LK, BTN_HK, MOT_QCF, MOT_QCB, MOT_DP, MOT_DD } from '../../../packages/motion'
import { F_CR_ATK, F_ATK1, F_ATK2, F_ATK3, F_FX_FIRST, FX_DX, FX_DY } from './frames'

// Damage and speed are expressed as PERCENTAGES of the baseline so a character reads as a sentence:
// "hits 25% harder, walks 15% slower". Absolute numbers per move per character would be 144 magic
// constants nobody could hold in their head at once.
export function defineRoster(heroArt: i32, hero2Art: i32, hero3Art: i32, warriorArt: i32) {
  //      chr sheet        hp   walk  power  special-1  special-2
  define(0, heroArt,      120,  100,   100,  MOT_QCF,   MOT_DP)   // HERO    — the balanced one
  define(1, hero2Art,     104,  128,    82,  MOT_QCF,   MOT_DP)   // SHINOBI — fast, light, tricky
  define(2, hero3Art,     116,  108,    96,  MOT_QCB,   MOT_DD)   // RONIN   — mid-range brawler
  define(3, warriorArt,   140,   76,   132,  MOT_QCF,   MOT_DD)   // WARRIOR — slow, hits like a truck

  // Which neighbouring cell each attack pose's overhang lives in, straight out of the generator.
  let c: i32 = 0
  while (c < 4) {
    let k: i32 = 0
    while (k < 10) {
      fighterDefFxCell(c, F_FX_FIRST + k, FX_DX[c * 10 + k], FX_DY[c * 10 + k])
      k = k + 1
    }
    c = c + 1
  }
}

// `| 0` because tish's `/` is not reliably a truncating integer divide (see packages/rng.tish).
function pct(base: i32, p: i32): i32 { return ((base * p) / 100) | 0 }

function define(chr: i32, sheet: i32, hp: i32, walk: i32, power: i32, sp1: i32, sp2: i32) {
  // Physics. Gravity and jump arc are shared: a fighting game where characters fall at different
  // rates is a fighting game where nobody can learn anti-airs.
  fighterDefChar(chr, sheet, hp, pct(320, walk), pct(250, walk), 0 - 1120, 62, 13, 52)

  // ── standing normals ──────────────────────────────────────────────────────────────────────────
  // Light punch: fast, safe, cancellable. The button you mash.
  fighterDefMove(chr, MV_LP, F_ATK1, 3, 3, 3, 6, pct(7, power), KIND_MID)
  fighterDefBox (chr, MV_LP, 10, 48, 26, 16, 16, 7, 190, 4)
  fighterDefInput(chr, MV_LP, 0, BTN_LP, 0, 0)
  // The chain. A light connects into ANY heavier button and into either special, which is what
  // makes "jab, jab, sweep" and "jab, heavy, fireball" both work without a single special case.
  fighterDefCancel(chr, MV_LP,
    (1 << MV_LK) | (1 << MV_HP) | (1 << MV_HK) | (1 << MV_CR_LP) | (1 << MV_CR_HK) |
    (1 << MV_SP1) | (1 << MV_SP2))

  // Heavy punch: the payoff. Slow enough to be whiff-punished, and minus on block.
  fighterDefMove(chr, MV_HP, F_ATK2, 3, 7, 4, 14, pct(15, power), KIND_MID)
  fighterDefBox (chr, MV_HP, 8, 46, 44, 20, 19, 10, 430, 8)
  fighterDefInput(chr, MV_HP, 0, BTN_HP, 0, 0)
  fighterDefCancel(chr, MV_HP, (1 << MV_SP1) | (1 << MV_SP2))

  // Light kick: a touch slower than the jab but it reaches further — the poke.
  fighterDefMove(chr, MV_LK, F_ATK1, 3, 4, 3, 8, pct(8, power), KIND_MID)
  fighterDefBox (chr, MV_LK, 14, 34, 32, 18, 17, 7, 230, 4)
  fighterDefInput(chr, MV_LK, 0, BTN_LK, 0, 0)
  fighterDefCancel(chr, MV_LK, (1 << MV_HP) | (1 << MV_HK) | (1 << MV_CR_HK) | (1 << MV_SP1) | (1 << MV_SP2))

  // Heavy kick: an overhead. Must be blocked STANDING, which is what beats a turtling crouch.
  fighterDefMove(chr, MV_HK, F_ATK3, 3, 10, 4, 16, pct(17, power), KIND_OVERHEAD)
  fighterDefBox (chr, MV_HK, 10, 52, 42, 24, 20, 11, 470, 8)
  fighterDefInput(chr, MV_HK, 0, BTN_HK, 0, 0)
  fighterDefCancel(chr, MV_HK, (1 << MV_SP1) | (1 << MV_SP2))
  // A sweep ends the string — it knocks down, so there is nothing left to hit.

  // ── crouching normals ─────────────────────────────────────────────────────────────────────────
  // Both use the single crouch-attack pose, so their clip length is 1 rather than 3.
  fighterDefMove(chr, MV_CR_LP, F_CR_ATK, 1, 3, 3, 6, pct(6, power), KIND_MID)
  fighterDefBox (chr, MV_CR_LP, 10, 26, 28, 14, 15, 6, 170, 3)
  fighterDefInput(chr, MV_CR_LP, 0, BTN_LP, 0, 0)
  fighterDefCancel(chr, MV_CR_LP,
    (1 << MV_CR_HK) | (1 << MV_LP) | (1 << MV_HP) | (1 << MV_SP1) | (1 << MV_SP2))

  // The sweep: a LOW, so it beats anyone blocking standing, and it knocks down hard.
  fighterDefMove(chr, MV_CR_HK, F_CR_ATK, 1, 7, 4, 18, pct(13, power), KIND_LOW)
  fighterDefBox (chr, MV_CR_HK, 10, 18, 46, 18, 24, 9, 520, 8)
  fighterDefInput(chr, MV_CR_HK, 0, BTN_HK, 0, 0)

  // ── specials ──────────────────────────────────────────────────────────────────────────────────
  // Special 1 is free and is the combo ender every normal cancels into.
  fighterDefMove(chr, MV_SP1, F_ATK2, 3, 8, 6, 20, pct(20, power), KIND_MID)
  fighterDefBox (chr, MV_SP1, 6, 48, 62, 26, 26, 12, 620, 10)
  fighterDefInput(chr, MV_SP1, sp1, BTN_HP, 0, 0)

  // Special 2 costs meter, hits harder, and can be done in the air.
  fighterDefMove(chr, MV_SP2, F_ATK3, 3, 6, 8, 24, pct(28, power), KIND_MID)
  fighterDefBox (chr, MV_SP2, 4, 56, 58, 40, 30, 14, 700, 14)
  fighterDefInput(chr, MV_SP2, sp2, BTN_HK, 30, 1)

  // ── throw ─────────────────────────────────────────────────────────────────────────────────────
  // Unblockable and very short range: the answer to an opponent who never stops blocking.
  fighterDefMove(chr, MV_THROW, F_ATK1, 1, 2, 2, 22, pct(18, power), KIND_UNBLOCKABLE)
  fighterDefBox (chr, MV_THROW, 6, 46, 20, 30, 30, 0, 780, 12)
  fighterDefInput(chr, MV_THROW, 0, BTN_LP | BTN_HP, 0, 0)
}
