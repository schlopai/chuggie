function put12(base: i32,
  a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32,
  b0: i32, b1: i32, b2: i32, b3: i32, b4: i32, b5: i32
) {
  SKL[base] = a0; SKL[base + 1] = a1; SKL[base + 2] = a2; SKL[base + 3] = a3
  SKL[base + 4] = a4; SKL[base + 5] = a5
  SKL[base + 6] = b0; SKL[base + 7] = b1; SKL[base + 8] = b2; SKL[base + 9] = b3
  SKL[base + 10] = b4; SKL[base + 11] = b5
}

function putFx(base: i32,
  a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32,
  b0: i32, b1: i32
) {
  SKL_FX[base] = a0; SKL_FX[base + 1] = a1; SKL_FX[base + 2] = a2; SKL_FX[base + 3] = a3
  SKL_FX[base + 4] = a4; SKL_FX[base + 5] = a5
  SKL_FX[base + 6] = b0; SKL_FX[base + 7] = b1
}

