export function classSkill(cls: i32, spec: i32, slot: i32): i32 {
  if (cls < 0 || cls >= CLS_COUNT) { return 0 }
  if (spec < 0 || spec >= SPEC_COUNT) { return 0 }
  if (slot < 0 || slot >= 12) { return 0 }
  return SKL[Math.imul(cls, 36) + Math.imul(spec, 12) + slot]
}

export function classSkillFx(cls: i32, spec: i32, slot: i32): i32 {
  if (cls < 0 || cls >= CLS_COUNT) { return FX_MELEE }
  if (spec < 0 || spec >= SPEC_COUNT) { return FX_MELEE }
  if (slot < 0 || slot >= 12) { return FX_MELEE }
  let fx: i32 = SKL_FX[Math.imul(cls, 36) + Math.imul(spec, 12) + slot]
  if (fx <= 0) { return FX_MELEE }
  return fx
}

// 0 peel/dps, 1 healer, 2 runner
export function specRole(cls: i32, spec: i32): i32 {
  if (cls === CLS_PALADIN && spec === 0) { return 1 }
  if (cls === CLS_PRIEST && spec === 1) { return 1 }
  if (cls === CLS_SHAMAN && spec === 2) { return 1 }
  if (cls === CLS_DRUID && spec === 2) { return 1 }
  if (cls === CLS_ROGUE) { return 2 }
  if (cls === CLS_HUNTER && spec === 1) { return 2 }
  if (cls === CLS_WARRIOR && spec === 0) { return 2 }
  return 0
}

/// Prefer this chord slot for bots of a given role/class (0..7).
export function botSkillSlot(cls: i32, spec: i32, role: i32, phase: i32): i32 {
  // phase 0..3 rotates through kit so bots don't spam only slot 0
  if (role === 1) {
    // Healer: primary heal, hot, absorb, occasional nuke
    if ((phase & 3) === 0) { return 0 }
    if ((phase & 3) === 1) { return 1 }
    if ((phase & 3) === 2) { return 4 }
    return 6
  }
  if (role === 2) {
    // Runner: gap closer / stun / slow / damage
    if (cls === CLS_ROGUE) {
      if ((phase & 3) === 0) { return 1 }
      if ((phase & 3) === 1) { return 6 }
      return 0
    }
    if ((phase & 3) === 0) { return 1 }
    if ((phase & 3) === 1) { return 0 }
    return 6
  }
  // Peel / mid: rotate damage + CC
  if ((phase & 3) === 0) { return 0 }
  if ((phase & 3) === 1) { return 3 }
  if ((phase & 3) === 2) { return 2 }
  return 5
}
