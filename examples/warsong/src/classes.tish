// classes.tish — 9 classic classes × 3 specs → 12 chord slots + FX + auto.
// Flat tables filled once at boot (no push/heap growth).

export let CLS_WARRIOR: i32 = 0
export let CLS_PALADIN: i32 = 1
export let CLS_HUNTER: i32 = 2
export let CLS_ROGUE: i32 = 3
export let CLS_PRIEST: i32 = 4
export let CLS_SHAMAN: i32 = 5
export let CLS_MAGE: i32 = 6
export let CLS_WARLOCK: i32 = 7
export let CLS_DRUID: i32 = 8
export let CLS_COUNT: i32 = 9
export let SPEC_COUNT: i32 = 3

// Auto-attack style: 1 melee, 2 bolt, 3 bolt (healer wand)
export let CLS_AUTO: i32[] = [1, 1, 2, 1, 3, 1, 2, 2, 1]

// FX ids — keep in sync with skills.tish FX_* constants
export let FX_MELEE: i32 = 1
export let FX_BOLT: i32 = 2
export let FX_AOE: i32 = 3
export let FX_HEAL: i32 = 4
export let FX_HOT: i32 = 5
export let FX_DOT: i32 = 6
export let FX_ABSORB: i32 = 7
export let FX_ROOT: i32 = 8
export let FX_SLOW: i32 = 9
export let FX_STUN: i32 = 10
export let FX_BLINK: i32 = 11
export let FX_CHARGE: i32 = 12
export let FX_SPEED: i32 = 13
export let FX_GUARD: i32 = 14
export let FX_PET: i32 = 15

