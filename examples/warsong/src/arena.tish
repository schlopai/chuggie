// arena.tish — Warsong Gulch geometry. The map itself is a Tiled `.tmj`
// (examples/warsong/assets/wsg.tmj, generated by scripts/gen_wsg.py) loaded via
// `scene:` → loadSceneRom. These rects are the NON-SOLID objective zones painted
// on that map; the ROM tests unit positions against them (soccer goal-gap pattern).

export let TILE: i32 = 16
export let MAP_W: i32 = 30
export let MAP_H: i32 = 18

// Alliance base / score zone (left painted floor).
export let BASE_A_X0: i32 = 1 * 16
export let BASE_A_Y0: i32 = 6 * 16
export let BASE_A_X1: i32 = 5 * 16
export let BASE_A_Y1: i32 = 12 * 16

// Horde base / score zone (right).
export let BASE_H_X0: i32 = 25 * 16
export let BASE_H_Y0: i32 = 6 * 16
export let BASE_H_X1: i32 = 29 * 16
export let BASE_H_Y1: i32 = 12 * 16

// Flag home stands (mid of each base).
export let FLAG_A_X: i32 = 3 * 16
export let FLAG_A_Y: i32 = 9 * 16
export let FLAG_H_X: i32 = 26 * 16
export let FLAG_H_Y: i32 = 9 * 16

// Graveyards (north of each base).
export let GY_A_X: i32 = 2 * 16
export let GY_A_Y: i32 = 3 * 16
export let GY_H_X: i32 = 27 * 16
export let GY_H_Y: i32 = 3 * 16

// Default spawns inside bases.
export let SPAWN_A_X: i32 = 2 * 16
export let SPAWN_A_Y: i32 = 8 * 16
export let SPAWN_H_X: i32 = 27 * 16
export let SPAWN_H_Y: i32 = 8 * 16

export function inRect(x: i32, y: i32, x0: i32, y0: i32, x1: i32, y1: i32): i32 {
  if (x < x0) { return 0 }
  if (y < y0) { return 0 }
  if (x >= x1) { return 0 }
  if (y >= y1) { return 0 }
  return 1
}

export function inAllianceBase(x: i32, y: i32): i32 {
  return inRect(x, y, BASE_A_X0, BASE_A_Y0, BASE_A_X1, BASE_A_Y1)
}

export function inHordeBase(x: i32, y: i32): i32 {
  return inRect(x, y, BASE_H_X0, BASE_H_Y0, BASE_H_X1, BASE_H_Y1)
}
