// names.tish — class / spec labels for select + HUD.

export function className(cls: i32) {
  if (cls === 0) { return "WARRIOR" }
  if (cls === 1) { return "PALADIN" }
  if (cls === 2) { return "HUNTER" }
  if (cls === 3) { return "ROGUE" }
  if (cls === 4) { return "PRIEST" }
  if (cls === 5) { return "SHAMAN" }
  if (cls === 6) { return "MAGE" }
  if (cls === 7) { return "WARLOCK" }
  return "DRUID"
}

export function specName(cls: i32, spec: i32) {
  if (cls === 0) {
    if (spec === 0) { return "Arms" }
    if (spec === 1) { return "Fury" }
    return "Protection"
  }
  if (cls === 1) {
    if (spec === 0) { return "Holy" }
    if (spec === 1) { return "Protection" }
    return "Retribution"
  }
  if (cls === 2) {
    if (spec === 0) { return "Beast Mastery" }
    if (spec === 1) { return "Marksmanship" }
    return "Survival"
  }
  if (cls === 3) {
    if (spec === 0) { return "Assassination" }
    if (spec === 1) { return "Combat" }
    return "Subtlety"
  }
  if (cls === 4) {
    if (spec === 0) { return "Discipline" }
    if (spec === 1) { return "Holy" }
    return "Shadow"
  }
  if (cls === 5) {
    if (spec === 0) { return "Elemental" }
    if (spec === 1) { return "Enhancement" }
    return "Restoration"
  }
  if (cls === 6) {
    if (spec === 0) { return "Arcane" }
    if (spec === 1) { return "Fire" }
    return "Frost"
  }
  if (cls === 7) {
    if (spec === 0) { return "Affliction" }
    if (spec === 1) { return "Demonology" }
    return "Destruction"
  }
  if (spec === 0) { return "Balance" }
  if (spec === 1) { return "Feral" }
  return "Restoration"
}
