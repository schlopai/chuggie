// Repro #654 heap: many FunDecls each naming `log`.
// Assert: VmRef::new(log…) count stays tiny (snapshots), no allocation OOM.
import { log, vblank, backdrop, hud_text, frame } from 'cargo:tish_agb'
import { body } from 'font:../../../assets/fonts/tinypixel.ttf@7'


// --- screen readout (scripts/add_screen_readout.py) ---
// Drawn up front so the ROM is never a blank screen; the measurement below is untouched.
backdrop(0x101018)
hud_text(0, 8, 8, "repro-654-heap-natives")
hud_text(1, 8, 24, "running - numbers go to the log")
frame()
function f0() { log("f0") }
function f1() { log("f1") }
function f2() { log("f2") }
function f3() { log("f3") }
function f4() { log("f4") }
function f5() { log("f5") }
function f6() { log("f6") }
function f7() { log("f7") }
function f8() { log("f8") }
function f9() { log("f9") }
function f10() { log("f10") }
function f11() { log("f11") }
function f12() { log("f12") }
function f13() { log("f13") }
function f14() { log("f14") }
function f15() { log("f15") }
function f16() { log("f16") }
function f17() { log("f17") }
function f18() { log("f18") }
function f19() { log("f19") }
function f20() { log("f20") }
function f21() { log("f21") }
function f22() { log("f22") }
function f23() { log("f23") }
function f24() { log("f24") }
function f25() { log("f25") }
function f26() { log("f26") }
function f27() { log("f27") }
function f28() { log("f28") }
function f29() { log("f29") }

let i: i32 = 0
while (i < 130) {
  if (i % 30 === 0) { f0() }
  else if (i % 30 === 1) { f1() }
  else if (i % 30 === 2) { f2() }
  else { f3() }
  vblank()
  i = i + 1
}
log("repro-654-heap-natives done")
hud_text(1, 8, 24, "done - numbers are in the log")
while (true) { frame() }
